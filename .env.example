# Пример файла с переменными окружения
# Скопируйте этот файл в .env и замените значения на свои

# Режим запуска приложения (development, production)
NODE_ENV=development

# URL подключения к PostgreSQL базе данных
DATABASE_URL=postgres://username:password@localhost:5432/damaskshop

# Секретный ключ для шифрования сессий
SESSION_SECRET=your-random-secret-key-change-me

# Порт для запуска приложения (по умолчанию 5000)
PORT=5000